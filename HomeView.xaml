<UserControl x:Class="MedicalSystem.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             d:DesignHeight="600" d:DesignWidth="1000"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:MedicalSystem"
             mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="Главная панель" Style="{StaticResource HeaderText}"/>

            <!-- Quick Stats -->
            <Border Background="White" CornerRadius="5" Padding="15" Margin="0,0,0,20" 
                    BorderBrush="#FFDDDDDD" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Patients Card -->
                    <Border Grid.Column="0" Margin="5" Background="#FFE0F7FA" CornerRadius="5" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Пациенты" FontWeight="Bold" Foreground="#FF008080"/>
                            <TextBlock x:Name="PatientsCount" Text="0" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/>
                            <Button Content="Просмотр" Style="{StaticResource SecondaryButton}" 
                                    Margin="0,10,0,0" Click="ViewPatients_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Doctors Card -->
                    <Border Grid.Column="1" Margin="5" Background="#FFE0F7FA" CornerRadius="5" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Врачи" FontWeight="Bold" Foreground="#FF008080"/>
                            <TextBlock x:Name="DoctorsCount" Text="0" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/>
                            <Button Content="Просмотр" Style="{StaticResource SecondaryButton}" 
                                    Margin="0,10,0,0" Click="ViewDoctors_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Appointments Card -->
                    <Border Grid.Column="2" Margin="5" Background="#FFE0F7FA" CornerRadius="5" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Приёмы сегодня" FontWeight="Bold" Foreground="#FF008080"/>
                            <TextBlock x:Name="AppointmentsCount" Text="0" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/>
                            <Button Content="Просмотр" Style="{StaticResource SecondaryButton}" 
                                    Margin="0,10,0,0" Click="ViewAppointments_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Sick Leaves Card -->
                    <Border Grid.Column="3" Margin="5" Background="#FFE0F7FA" CornerRadius="5" Padding="10">
                        <StackPanel>
                            <TextBlock Text="Активные больничные" FontWeight="Bold" Foreground="#FF008080"/>
                            <TextBlock x:Name="SickLeavesCount" Text="0" FontSize="24" FontWeight="Bold" Margin="0,5,0,0"/>
                            <Button Content="Просмотр" Style="{StaticResource SecondaryButton}" 
                                    Margin="0,10,0,0" Click="ViewSickLeaves_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Recent Activity -->
            <TextBlock Text="Активные больничные листы" Style="{StaticResource HeaderText}"/>
            <DataGrid x:Name="RecentSickLeavesGrid" Style="{StaticResource DataGridStyle}" 
                      ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                      Height="250" AutoGenerateColumns="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding SickLeaveId}" Width="Auto"/>
                    <DataGridTextColumn Header="Пациент" Binding="{Binding PatientName}" Width="*"/>
                    <DataGridTextColumn Header="Врач" Binding="{Binding DoctorName}" Width="*"/>
                    <DataGridTextColumn Header="Дата выдачи" Binding="{Binding start_date, StringFormat=d}" Width="Auto"/>
                    <DataGridTextColumn Header="Телефон" Binding="{Binding phone_number}" Width="Auto"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Quick Actions -->
            <StackPanel Margin="0,20,0,0">
                <TextBlock Text="Быстрые действия" Style="{StaticResource HeaderText}"/>
                <WrapPanel>
                    <Button Content="Создать больничный лист" Style="{StaticResource ActionButton}" 
                            Margin="0,0,10,10" Click="CreateSickLeave_Click"/>
                    <Button Content="Зарегистрировать пациента" Style="{StaticResource ActionButton}" 
                            Margin="0,0,10,10" Click="RegisterPatient_Click"/>
                    <Button Content="Запланировать приём" Style="{StaticResource ActionButton}" 
                            Margin="0,0,10,10" Click="ScheduleAppointment_Click"/>
                </WrapPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>