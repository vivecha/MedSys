<Window x:Class="MedicalSystem.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в систему" Height="250" Width="400" ResizeMode="NoResize">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Логин:" Style="{StaticResource FormLabel}" Margin="0 0 0 5"/>
            <TextBox x:Name="txtUsername" Margin="0 0 0 10"/>

            <TextBlock Text="Пароль:" Style="{StaticResource FormLabel}" Margin="0 0 0 5"/>
            <PasswordBox x:Name="txtPassword" Margin="0 0 0 20"/>

            <Button x:Name="btnLogin" Content="Войти" Height="30" Style="{StaticResource ActionButton}" Click="BtnLogin_Click"/>

            <TextBlock x:Name="txtError" Foreground="Red" Margin="0 10 0 0" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>