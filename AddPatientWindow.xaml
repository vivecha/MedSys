<Window x:Class="MedicalSystem.Views.AddPatientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Добавление пациента" 
        Height="600" 
        Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Style="{StaticResource WindowStyle}">

    <Grid Background="#FFF5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#FFEEEEEE" Padding="20,10">
            <TextBlock Text="Добавить нового пациента" 
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="#FF333333"/>
        </Border>

        <!-- Форма -->
        <ScrollViewer Grid.Row="1" Padding="20" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Основная информация -->
                <TextBlock Text="Основная информация" FontWeight="Bold" Margin="0,0,0,10"/>

                <!-- Фамилия -->
                <TextBlock Text="Фамилия*" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="LastNameTextBox" Style="{StaticResource FormTextBox}"/>

                <!-- Имя -->
                <TextBlock Text="Имя*" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="FirstNameTextBox" Style="{StaticResource FormTextBox}"/>

                <!-- Отчество -->
                <TextBlock Text="Отчество" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="MiddleNameTextBox" Style="{StaticResource FormTextBox}"/>

                <!-- Дата рождения -->
                <TextBlock Text="Дата рождения*" Style="{StaticResource FormLabel}"/>
                <DatePicker x:Name="BirthDatePicker" Style="{StaticResource FormDatePicker}"/>

                <!-- Пол -->
                <TextBlock Text="Пол*" Style="{StaticResource FormLabel}"/>
                <ComboBox x:Name="GenderComboBox" Style="{StaticResource FormComboBox}">
                    <ComboBoxItem Content="Мужской" Tag="Male"/>
                    <ComboBoxItem Content="Женский" Tag="Female"/>
                </ComboBox>

                <!-- Контактная информация -->
                <TextBlock Text="Контактная информация" FontWeight="Bold" Margin="0,20,0,10"/>

                <!-- Телефон -->
                <TextBlock Text="Телефон*" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="PhoneTextBox" Style="{StaticResource FormTextBox}"/>

                <!-- Email -->
                <TextBlock Text="Email" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="EmailTextBox" Style="{StaticResource FormTextBox}"/>

                <!-- Адрес -->
                <TextBlock Text="Адрес*" Style="{StaticResource FormLabel}"/>
                <TextBox x:Name="AddressTextBox" Style="{StaticResource FormTextBox}" Height="60" 
                         TextWrapping="Wrap" AcceptsReturn="True"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <Border Grid.Row="2" Background="#FFEEEEEE" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отменить" 
                        Width="100"
                        Height="30"
                        Margin="0,0,10,0"
                        Background="#FFDDDDDD"
                        Foreground="#FF333333"
                        BorderBrush="#FFCCCCCC"
                        Click="CancelButton_Click"/>
                <Button Content="Сохранить" 
                        Width="100"
                        Height="30"
                        Background="#FF008080"
                        Foreground="White"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>