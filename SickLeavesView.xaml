<UserControl x:Class="MedicalSystem.Views.SickLeavesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header and Filters -->
        <StackPanel Grid.Row="0" Margin="20,20,20,10">
            <TextBlock Text="Управление больничными листами" Style="{StaticResource HeaderText}"/>

            <Border Background="White" CornerRadius="5" Padding="10" BorderBrush="#FFDDDDDD" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Patient Filter -->
                    <StackPanel Grid.Column="0" Margin="5">
                        <TextBlock Text="Пациент" Style="{StaticResource FormLabel}"/>
                        <ComboBox x:Name="PatientFilter" Style="{StaticResource FormComboBox}" 
                                  DisplayMemberPath="FullName"/>
                    </StackPanel>

                    <!-- Doctor Filter -->
                    <StackPanel Grid.Column="1" Margin="5">
                        <TextBlock Text="Врач" Style="{StaticResource FormLabel}"/>
                        <ComboBox x:Name="DoctorFilter" Style="{StaticResource FormComboBox}" 
                                  DisplayMemberPath="FullName"/>
                    </StackPanel>

                    <!-- Status Filter -->
                    <StackPanel Grid.Column="2" Margin="5">
                        <TextBlock Text="Статус" Style="{StaticResource FormLabel}"/>
                        <ComboBox x:Name="StatusFilter" Style="{StaticResource FormComboBox}">
                            <ComboBoxItem Content="Все"/>
                            <ComboBoxItem Content="Активные"/>
                            <ComboBoxItem Content="Закрытые"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="3" VerticalAlignment="Bottom" Margin="5">
                        <Button Content="Применить фильтры" Margin="0,5,0,0" Style="{StaticResource ActionButton}" 
                                Click="ApplyFilters_Click"/>
                        <Button Content="Сбросить" Style="{StaticResource SecondaryButton}" 
                                Margin="0,5,0,0" Click="ResetFilters_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Action Buttons -->
            <WrapPanel Margin="0,10,0,0">
                <Button Content="Создать больничный" Style="{StaticResource ActionButton}" 
                        Click="CreateSickLeave_Click"/>
                <Button Content="Редактировать" Style="{StaticResource SecondaryButton}" 
                         Click="EditSickLeave_Click"/>
                <Button Content="Закрыть больничный" Style="{StaticResource SecondaryButton}" 
                         Click="CloseSickLeave_Click"/>
                <Button Content="Печать" Style="{StaticResource SecondaryButton}" 
                         Click="PrintSickLeave_Click"/>
            </WrapPanel>
        </StackPanel>

        <!-- Data Grid -->
        <Border Grid.Row="1" Margin="20,0,20,20" Background="White" CornerRadius="5"
                BorderBrush="#FFDDDDDD" BorderThickness="1">
            <!-- DataGrid для отображения больничных листов -->
            <DataGrid x:Name="SickLeavesGrid" Style="{StaticResource DataGridStyle}" 
                      ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                      AutoGenerateColumns="False" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding SickLeaveId}" Width="Auto"/>
                    <DataGridTextColumn Header="Пациент" Binding="{Binding PatientName}" Width="*"/>
                    <DataGridTextColumn Header="Врач" Binding="{Binding DoctorName}" Width="*"/>
                    <DataGridTextColumn Header="Начало" Binding="{Binding StartDate, StringFormat=d}" Width="Auto"/>
                    <DataGridTextColumn Header="Окончание" Binding="{Binding EndDate, StringFormat=d}" Width="Auto"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="Auto"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>