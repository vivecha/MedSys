<Window x:Class="MedicalSystem.Views.EditAppointmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование приема" 
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Детали приема -->
        <TextBlock Text="Детали приема" Style="{StaticResource HeaderText}" Grid.Row="0" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1">
            <!-- Пациент -->
            <TextBlock Text="Пациент:" Style="{StaticResource FormLabel}"/>
            <ComboBox x:Name="PatientComboBox"/>

            <!-- Врач -->
            <TextBlock Text="Врач:"  Margin="0,10,0,0" Style="{StaticResource FormLabel}"/>
            <ComboBox x:Name="DoctorComboBox"/>

            <!-- Дата и время приема -->
                <TextBlock Text="Дата приема:" Margin="0,10,0,0" Style="{StaticResource FormLabel}"/>
                <DatePicker x:Name="AppointmentDatePicker" Style="{StaticResource FormDatePicker}"/>

                <!-- Время приема -->
                <TextBlock Text="Время приема:" Margin="0,10,0,0" Style="{StaticResource FormLabel}"/>
                <ComboBox x:Name="TimeComboBox" IsEditable="True" Text="Выберите или введите время (HH:mm)">
                    <ComboBoxItem>08:00</ComboBoxItem>
                    <ComboBoxItem>09:00</ComboBoxItem>
                    <ComboBoxItem>10:00</ComboBoxItem>
                    <ComboBoxItem>11:00</ComboBoxItem>
                    <ComboBoxItem>12:00</ComboBoxItem>
                    <ComboBoxItem>13:00</ComboBoxItem>
                    <ComboBoxItem>14:00</ComboBoxItem>
                    <ComboBoxItem>15:00</ComboBoxItem>
                    <ComboBoxItem>16:00</ComboBoxItem>
                    <ComboBoxItem>17:00</ComboBoxItem>
                    <ComboBoxItem>18:00</ComboBoxItem>
                    <ComboBoxItem>19:00</ComboBoxItem>
                    <ComboBoxItem>20:00</ComboBoxItem>
                </ComboBox>
                
                <!-- Жалобы -->
            <TextBlock Text="Жалобы:" Margin="0,10,0,0" Style="{StaticResource FormLabel}"/>
            <TextBox x:Name="ComplaintsTextBox" AcceptsReturn="True" Height="50"/>

            <!-- Диагноз -->
            <TextBlock Text="Диагноз:"  Margin="0,10,0,0" Style="{StaticResource FormLabel}"/>
            <TextBox x:Name="DiagnosisTextBox" AcceptsReturn="True" Height="50"/>

            <!-- Лечение -->
            <TextBlock Text="Лечение:"  Margin="0,10,0,0" Style="{StaticResource FormLabel}"/>
            <TextBox x:Name="TreatmentTextBox" AcceptsReturn="True" Height="50"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Сохранить" Style="{StaticResource ActionButton}" Click="SaveButton_Click" Margin="0,0,10,0"/>
            <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Click="CancelButton_Click" Margin="0,0,10,0"/>
        </StackPanel>
    </Grid>
</Window>
