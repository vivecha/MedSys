<Window x:Class="MedicalSystem.Views.SickLeaveFormWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Больничный лист" 
        Height="600" 
        Width="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock x:Name="FormTitle" Text="Создание больничного листа" Style="{StaticResource HeaderText}"/>

            <Border Background="White" CornerRadius="5" Padding="15" BorderBrush="#FFDDDDDD" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Patient Selection -->
                    <StackPanel Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
                        <TextBlock Text="Пациент*" Style="{StaticResource FormLabel}"/>
                        <ComboBox x:Name="PatientComboBox" Style="{StaticResource FormComboBox}" 
                                  DisplayMemberPath="FullName"/>
                    </StackPanel>

                    <!-- Doctor Selection -->
                    <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,10,10">
                        <TextBlock Text="Врач*" Style="{StaticResource FormLabel}"/>
                        <ComboBox x:Name="DoctorComboBox" Style="{StaticResource FormComboBox}" 
                                  DisplayMemberPath="FullName"/>
                    </StackPanel>

                    <!-- Appointment Selection -->
                    <StackPanel Grid.Column="1" Grid.Row="1" Margin="10,0,0,10">
                        <TextBlock Text="Приём*" Style="{StaticResource FormLabel}"/>
                        <ComboBox x:Name="AppointmentComboBox" Style="{StaticResource FormComboBox}" 
                                  DisplayMemberPath="AppointmentDate"/>
                    </StackPanel>



                    <!-- Start Date -->
                    <StackPanel Grid.Row="2" Margin="5,5,5,5">
                        <TextBlock Text="Дата начала*" Style="{StaticResource FormLabel}"/>
                        <DatePicker x:Name="StartDatePicker" Style="{StaticResource FormDatePicker}"/>
                    </StackPanel>

                    <!-- End Date -->
                    <StackPanel Grid.Column="1" Grid.Row="2" Margin="5,5,5,5">
                        <TextBlock Text="Дата окончания*" Style="{StaticResource FormLabel}"/>
                        <DatePicker x:Name="EndDatePicker" Style="{StaticResource FormDatePicker}"/>
                    </StackPanel>

                    <!-- Diagnosis -->
                    <StackPanel Grid.Column="0" Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,0,10">
                        <TextBlock Text="Диагноз*" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="DiagnosisTextBox" Style="{StaticResource FormTextBox}" 
                                 Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </StackPanel>

                    <!-- Notes -->
                    <StackPanel Grid.Column="0" Grid.Row="5" Grid.ColumnSpan="2" Margin="0,0,0,10">
                        <TextBlock Text="Примечания" Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="NotesTextBox" Style="{StaticResource FormTextBox}" 
                                 Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="0" Grid.Row="6" Grid.ColumnSpan="2" 
                                Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Сохранить" Style="{StaticResource ActionButton}" 
                                Click="SaveButton_Click" Margin="10,0,0,0"/>
                        <Button Content="Отмена" Style="{StaticResource SecondaryButton}" 
                                Margin="10,0,0,0" Click="CancelButton_Click"/>
                    </StackPanel>

                    <!-- Status Message -->
                    <TextBlock x:Name="StatusMessage" Grid.Column="0" Grid.Row="7" Grid.ColumnSpan="2" 
                               Margin="0,10,0,0" Foreground="Red" TextWrapping="Wrap"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>