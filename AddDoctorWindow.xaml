<Window x:Class="MedicalSystem.Views.AddDoctorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" 
        Height="550" 
        Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource WindowStyle}">

    <Grid Background="#FFF5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#FFEEEEEE" Padding="20,10">
            <TextBlock Text="{Binding WindowTitle}" 
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="#FF333333"/>
        </Border>

        <!-- Форма -->
        <ScrollViewer Grid.Row="1" Padding="20" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Основная информация -->
                <TextBlock Text="Личные данные" FontWeight="Bold" Margin="0,0,0,10"/>

                <!-- Фамилия -->
                <TextBlock Text="Фамилия*" Style="{StaticResource FormLabel}"/>
                <TextBox Text="{Binding CurrentDoctor.LastName}" Style="{StaticResource FormTextBox}"/>

                <!-- Имя -->
                <TextBlock Text="Имя*" Style="{StaticResource FormLabel}"/>
                <TextBox Text="{Binding CurrentDoctor.FirstName}" Style="{StaticResource FormTextBox}"/>

                <!-- Отчество -->
                <TextBlock Text="Отчество" Style="{StaticResource FormLabel}"/>
                <TextBox Text="{Binding CurrentDoctor.MiddleName}" Style="{StaticResource FormTextBox}"/>

                <!-- Email -->
                <TextBlock Text="Email*" Style="{StaticResource FormLabel}"/>
                <TextBox Text="{Binding CurrentDoctor.Email}" Style="{StaticResource FormTextBox}"/>

                <!-- Учетные данные -->
                <TextBlock Text="Учетные данные" FontWeight="Bold" Margin="0,20,0,10"/>

                <!-- Логин -->
                <TextBlock Text="Логин*" Style="{StaticResource FormLabel}"/>
                <TextBox Text="{Binding CurrentDoctor.Username}" Style="{StaticResource FormTextBox}"/>

                <!-- Специальность -->
                <TextBlock Text="Специальность*" Style="{StaticResource FormLabel}"/>
                <ComboBox ItemsSource="{Binding Specialties}" 
                          DisplayMemberPath="SpecialtyName"
                          SelectedValuePath="SpecialtyId"
                          SelectedValue="{Binding CurrentDoctor.SpecialtyId}"
                          Style="{StaticResource FormComboBox}"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <Border Grid.Row="2" Background="#FFEEEEEE" Padding="10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отменить" 
                        Width="100"
                        Height="30"
                        Margin="0,0,10,0"
                        Background="#FFDDDDDD"
                        Foreground="#FF333333"
                        BorderBrush="#FFCCCCCC"
                        Click="CancelButton_Click"/>
                <Button Content="Сохранить" 
                        Width="100"
                        Height="30"
                        Background="#FF008080"
                        Foreground="White"
                        Click="SaveButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>